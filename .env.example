# MongoDB Atlas connection string (copy from Atlas > Connect > Drivers)
MONGODB_URI=mongodb+srv://<username>:<password>@<cluster-host>/student-marketplace?retryWrites=true&w=majority

# Long random string used to sign login tokens
# Example command to create one: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=replace-with-a-long-random-string

# Public URL of the app (used only for display / links)
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Optional image hosting (Cloudinary). Leave blank to disable photo uploads.
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
